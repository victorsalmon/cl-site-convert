{
  "manifestVersion": "1.1.0",
  "name": "pabbly-sink",
  "version": "0.1.0",
  "role": "sink",
  "consumes": ["form-submission"],
  "acceptsIrRange": "^1.1.0",
  "emits": ["api-functions"],
  "sinks": ["pabbly", "webhook"],
  "hooks": ["sink:submit", "sink:deliver"],
  "entrypoint": { "module": "index.mjs", "hooksExport": "hooks" },
  "assets": [],
  "runbook": "runbook.md",
  "configSchema": "config.schema.json",
  "config": { "inline": { "retryAttempts": 3, "timeoutMs": 10000 } }
}
