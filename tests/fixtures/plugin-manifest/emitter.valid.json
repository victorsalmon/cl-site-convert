{
  "manifestVersion": "1.1.0",
  "name": "static-html-emitter",
  "version": "0.1.0",
  "role": "emitter",
  "consumes": ["site-ir"],
  "acceptsIrRange": "^1.1.0",
  "emits": ["static-html", "islands-wasm"],
  "hooks": ["emit:page", "emit:site"],
  "entrypoint": { "module": "dist/index.js", "hooksExport": "hooks" },
