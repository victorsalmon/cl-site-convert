{
  "name": "cl-site-convert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live WordPress site to static HTML (+ Rust/Wasm islands) conversion engine.",
  "bin": {
    "cl-site-convert": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "pwsh -NoProfile -File scripts/gate.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.9",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
